<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ortek_arby.AiCompanyDashboard">
        <div class="d-flex flex-column h-100 bg-view">
            <!-- Cabeçalho do Chat -->
            <div class="p-3 border-bottom bg-light d-flex align-items-center justify-content-between">
                <h4 class="m-0 text-primary">
                    <i class="fa fa-robot me-2"/>ORTEK AI Assistant
                </h4>
                <span class="badge bg-success">Online</span>
            </div>

            <!-- Corpo da Conversa -->
            <div class="flex-grow-1 p-3 overflow-auto" t-ref="chatContainer">
                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                    <div t-attf-class="d-flex mb-3 #{msg.sender == 'user' ? 'justify-content-end' : 'justify-content-start'}">
                        <div t-attf-class="p-3 rounded-3 #{msg.sender == 'user' ? 'bg-primary text-white' : 'bg-light border text-dark'}" style="max-width: 70%; width: fit-content;">
                            <div class="fw-bold mb-1 small" t-esc="msg.sender == 'user' ? 'Você' : 'ORTEK AI'"/>
                            <div class="text-break" t-esc="msg.text"/>
                            <div class="text-end mt-1 small opacity-75" style="font-size: 0.75rem;" t-esc="msg.time"/>
                        </div>
                    </div>
                </t>
                <t t-if="state.isLoading">
                    <div class="d-flex justify-content-start mb-3">
                        <div class="p-3 rounded-3 bg-light border text-muted">
                            <i class="fa fa-circle-o-notch fa-spin me-2"/>A processar resposta...
                        </div>
                    </div>
                </t>
            </div>

            <!-- Caixas de Entrada de Texto -->
            <div class="p-3 border-top bg-light">
                <div class="input-group">
                    <textarea class="form-control"
                              rows="1"
                              placeholder="Escreva a sua mensagem..."
                              t-model="state.inputMessage"
                              t-on-keydown="onKeydown"/>
                    <button class="btn btn-primary"
                            t-on-click="sendMessage"
                            t-att-disabled="state.isLoading">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>