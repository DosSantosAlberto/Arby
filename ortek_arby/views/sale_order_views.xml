<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Kanban para o Ciclo de Encomendas ARBY -->
        <record id="view_sale_order_kanban_arby" model="ir.ui.view">
            <field name="name">sale.order.kanban.arby</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="arby_stage_id" class="o_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="amount_total"/>
                    <field name="payment_verified"/>
                    <field name="deadline_date"/>
                    <field name="activity_ids"/>
                    <progressbar field="payment_verified" colors='{"true": "success", "false": "danger"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click p-2">
                                <div class="o_kanban_record_top mb-2">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="float-end badge rounded-pill text-bg-light">
                                        <field name="amount_total" widget="monetary"/>
                                    </span>
                                </div>
                                <div class="text-muted">
                                    <field name="partner_id"/>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-2">
                                    <span t-if="record.payment_verified.raw_value" class="badge text-bg-success">
                                        Pagamento Ok
                                    </span>
                                    <span t-else="" class="badge text-bg-warning">
                                        Pendente Pagamento
                                    </span>
                                    <small class="text-muted" t-if="record.deadline_date.raw_value">
                                        Prazo: <field name="deadline_date"/>
                                    </small>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Herança da Form View de Sale Order -->
        <record id="view_order_form_inherit_arby" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.arby</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Statusbar com Etapas ARBY -->
                <xpath expr="//header" position="inside">
                    <button name="action_verify_payment"
                            string="Validar Pagamento"
                            type="object"
                            class="btn-success"
                            invisible="payment_verified == True"/>
                    <field name="arby_stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </xpath>

                <!-- Campos de Pagamento e Prazos -->
                <xpath expr="//group[@name='order_details']" position="inside">
                    <field name="payment_verified" widget="boolean_toggle"/>
                    <field name="payment_proof" filename="payment_proof_filename"/>
                    <field name="payment_proof_filename" invisible="1"/>
                    <field name="deadline_date"/>
                </xpath>
            </field>
        </record>

        <!-- Ação para abrir Kanban ARBY -->
        <record id="action_arby_orders" model="ir.actions.act_window">
            <field name="name">Pipeline ARBY Store</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_sale_order_kanban_arby"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhuma encomenda em processamento.
                </p>
            </field>
        </record>
    </data>
</odoo>