<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Adicionar cartão ORTEK ARBY no Painel Principal do Portal -->
        <template id="portal_my_home_arby" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Acompanhamento de Encomendas &amp; Provas</t>
                    <t t-set="url" t-value="'/my/arby/fittings'"/>
                    <t t-set="placeholder_count" t-value="'arby_orders_count'"/>
                    <t t-set="icon" t-value="'/ortek_arby/static/description/icon.png'"/>
                </t>
            </xpath>
        </template>

        <!-- Adicionar Migalhas de Pão (Breadcrumbs) para Navegação -->
        <template id="portal_my_home_menu_arby" inherit_id="portal.portal_breadcrumbs" priority="30">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'arby_fittings'" class="breadcrumb-item active">
                    <span>Minhas Encomendas &amp; Provas</span>
                </li>
            </xpath>
        </template>

        <!-- Página de Listagem de Encomendas da Cliente no Portal -->
        <template id="portal_my_fittings_template" name="Minhas Encomendas ARBY">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Minhas Encomendas &amp; Provas</t>
                </t>

                <t t-if="not orders">
                    <p class="alert alert-warning">Ainda não possui encomendas registadas no seu perfil.</p>
                </t>

                <t t-if="orders">
                    <div class="table-responsive">
                        <table class="table table-hover bg-white rounded shadow-sm align-middle">
                            <thead class="thead-light">
                                <tr>
                                    <th>Referência</th>
                                    <th>Data</th>
                                    <th>Etapa de Processamento</th>
                                    <th>Estado do Pagamento</th>
                                    <th>Prazo Estimado</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="orders" t-as="order">
                                    <td>
                                        <a t-attf-href="/my/orders/#{order.id}">
                                            <strong t-field="order.name"/>
                                        </a>
                                    </td>
                                    <td><span t-field="order.date_order" t-options="{'widget': 'date'}"/></td>
                                    <td>
                                        <span class="badge rounded-pill bg-info text-white" t-field="order.arby_stage_id.name"/>
                                    </td>
                                    <td>
                                        <span t-if="order.payment_verified" class="badge text-bg-success">Validado</span>
                                        <span t-else="" class="badge text-bg-warning">Aguarda Validação</span>
                                    </td>
                                    <td>
                                        <span t-if="order.deadline_date" t-field="order.deadline_date" t-options="{'widget': 'date'}"/>
                                        <span t-else="" class="text-muted">-</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>